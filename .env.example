# Local chain: start `anvil` and keep these values. Everyone knows anvil's default keys, so use your own keys on a
# public network such as Base Sepolia (RPC_URL=https://sepolia.base.org).
RPC_URL=http://127.0.0.1:8545

# Deploys and opens markets (anvil account 0)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Stakers, used with `--as alice` and `--as bob` (anvil accounts 1 and 2)
ALICE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BOB_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# The keeper agent, which settles markets and pays for priced Airnode calls (anvil account 3)
AGENT_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# The address that the deploy script prints. This is the first contract deployed on a fresh anvil.
MARKET_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Every Airnode call is paid over x402 in AirnodeHub USD (aUSD) on Base Sepolia, whatever chain the market is on. The
# payer is PAYER_PRIVATE_KEY if set, or else AGENT_PRIVATE_KEY. It needs aUSD but no ETH, because the facilitator pays
# the gas. On anvil, set this to a key that holds aUSD on Base Sepolia. Check and mint with `pnpm payer`, or use
# https://api3dao.github.io/airnodehub-hackathon/faucet/
# PAYER_PRIVATE_KEY=
# Most the agent pays for one call, and for all calls in one run, in dollars
X402_MAX_PAYMENT=0.10
X402_BUDGET=1.00
# Base Sepolia RPC for `pnpm payer`, whatever chain RPC_URL points at
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
